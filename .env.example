# Authentication and data modes are independent. Demo needs no Supabase keys.
VITE_AUTH_MODE=demo
VITE_DATA_MODE=mock

# For real login, set VITE_AUTH_MODE=supabase in .env.local and replace these placeholders.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Backend origin for `api` mode, e.g. http://127.0.0.1:8000
# Public configuration only: an HTTP(S) origin with no credentials, query or fragment.

# Browser variables are public. Never use a secret or service-role key here.

# Backend base URL for authenticated report creation.
VITE_API_BASE_URL=
